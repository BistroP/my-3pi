/**
 * Blink the default LED on the
 * <a href="https://www.pololu.com/docs/0J86">Pololu 3pi+ 2040 robot</a>.
 * @author Abhi Gundrala
 * @author Edward A. Lee
 */
target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true
}
import Display from "lib/Display.lf"

preamble {=
  #include <stdio.h>
  #include <pico/stdlib.h>
  #include <hardware/gpio.h>
=}


main reactor {
  timer t(0, 250 ms)
  state led_on: bool = false
  d = new Display() 
  
 

  reaction(startup) {=
    gpio_init(PICO_DEFAULT_LED_PIN);
    gpio_set_dir(PICO_DEFAULT_LED_PIN, GPIO_IN);
  =} 


reaction(t) -> d.line0{=
  uint32_t *in = (uint32_t*)0xd0000004 
  uint32_t mask = 1ul << PICO_DEFAULT_LED_PIN 
    /// TODO: define max string size for line
    /// based on font you can have 4 or 8 lines
    static char buf0[17];

    snprintf(buf0, 17, "Button_Status:%2.4f", gpio_get(PICO_DEFAULT_LED_PIN));
    lf_set(d.line0, buf0);

  =}


}