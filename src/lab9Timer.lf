target C {
  platform: "RP2040",
  single-threaded: true,
  keepalive: true
}

import Display from "lib/Display.lf"

preamble {=
  #include <hardware/gpio.h>
  #include <pico/stdlib.h>
  #define ALARM_NUM 0
=} 

// For every interrupt set the new value to the top of the list.
// Sorted list of virtual_timers 
// List:
// TImer 1 = T_start1 + 1s
// Timer 2 = Tstart_2 + 3s.

// Keep a list of all the events. Set a timer to interrupt for the soonest one. WHen it triggerst, handle the event.
// And make sure the new soonest inst expired.

// #define timer_hw ((timer_hw*))TIMER_BASE

// 1s.
/// 1.000001s. 

// Enabling Interrupts:
// 1. Enable th ealarm to generate interrupts. Interrupts are enabled by the register INTE. hw_set_bits might be useful.
// 2. 

main reactor {
  preamble {=
    static uint32_t timer_id_counter = 0; // Counter to generate unique timer IDs

    typedef void (*virtual_timer_callback_t)(void);
 
    // Definition of linked list node 
    typedef struct node_t {
      /* Put the variables needed for linked list node here */
      // value for the timer
      uint32_t timer_value;
      uint32_t period_value;
      uint32_t timer_id;
      bool repeated;

      void (*callback)(uint32_t); // Add callback fucntion pointer in the lpinekd list node.

      /*********************************************
          DO NOT CHANGE THE CODE BELOW
      *********************************************/
      // next node pointer
      struct node_t * next;
      } node_t;

    //The linked list for timer
    static node_t* linked_list = NULL;

    // linked list operation functions
    // insert the node in the sorted linked list (linked_list) and return the sorted linked list after the insertion
    void list_insert_sorted(node_t* node){
       if(linked_list == NULL){
          node -> next = NULL;
          linked_list = node;
       }
       else{
          if(linked_list -> timer_value > node -> timer_value){
              node -> next = linked_list;
              linked_list = node;
            }     
          else{
              // node is somewhere after the head
              node_t* prev_node = linked_list;
              node_t* curr_node = linked_list->next;
              while(curr_node != NULL && curr_node -> timer_value < node -> timer_value){
                  // iterate until end of list or the current node has a greater value
                  prev_node = curr_node;
                  curr_node = curr_node -> next;
              }
              // insert node
              prev_node -> next = node;
              node -> next = curr_node;
          } 
       }
    }

    // remove the node from linked list
    void list_remove(node_t* node){
        if(linked_list != NULL){
            if(linked_list == node){
                linked_list = linked_list -> next;
            }
            else{
                node_t* prev_node = linked_list;
                node_t* curr_node = linked_list -> next;
                while(curr_node != NULL && curr_node != node){
                    prev_node = curr_node;
                    curr_node = curr_node -> next;
                }
                if(curr_node != NULL){
                    prev_node -> next = curr_node -> next; 
                }
            }
        }
    }
    // return and remove the first node in the linked list
    node_t* list_remove_first(){
      node_t* head = linked_list;
      if (head != NULL) {
          linked_list = head->next;
      }
      return head;
    }
    
    /*********************************************
        DO NOT CHANGE THE CODE ABOVE
    *********************************************/
   #define ALARM_NUM 0
   #define ALARM_IRQ timer_hardware_alarm_get_irq_num(timer_hw, ALARM_NUM)

    /* You can also create your own linked list functions here. */
    static volatile bool alarm_fired = false;
    volatile bool led = true;
      // 1.
//
// 2.
// Return a unique timer ID from the start function. 
// 
// 
    void lab5_timer_irq_handler(void){
        /* TODO */
        // Handle the interrupt. 
        hw_clear_bits(&timer_hw->intr, 1u << ALARM_NUM);  // Enable the alarm's interrupt
        printf("Alarm fired!");
        alarm_fired = true;
        node_t* head = list_remove_first();
        if (head != NULL) {
            head->callback(head->timer_id);
            if(head->repeated == true) {
                head->timer_value = head->period_value + timer_hw->timelr;
                list_insert_sorted(head);
            } else {
                free(head);
            }
        }
   

        while (linked_list != NULL && linked_list->timer_value < timer_hw->timelr) {
            node_t* head = list_remove_first();
            
            head->callback(head->timer_id);
            if(head->repeated == true) {
                head->timer_value = head->period_value + timer_hw->timelr;
                list_insert_sorted(head);
            } else {
                free(head);
            }
            
        }
        if(linked_list != NULL) {
            timer_hw->alarm[ALARM_NUM] = linked_list->timer_value;
        } else {
            timer_hw->alarm[ALARM_NUM] = 0;
        }
            
        
    }
    void virtual_timer_init(void){
    //    printf("Init check!");
        hw_set_bits(&timer_hw->inte, 1u << ALARM_NUM);  // Enable the alarm' s interrupt
        irq_set_exclusive_handler(ALARM_IRQ, lab5_timer_irq_handler); // register my irl handler functio
        irq_set_enabled(ALARM_IRQ, true);
        /* TODO */
    }
    void virtual_timer_set_callback(uint32_t timer_id){
        /* TODO */
        printf("Callback for %ul\n", timer_id);
        if (led) {
            gpio_put(PICO_DEFAULT_LED_PIN, false);
            led = false;
        } else {
            gpio_put(PICO_DEFAULT_LED_PIN, true);
            led = true;
        }

    }
    node_t* virtual_timer_start(uint32_t microseconds, virtual_timer_callback_t cb){
        //printf("Started check!");
        uint32_t current = timer_hw->timelr;
        node_t* node = malloc(sizeof(node_t));
        node->timer_value = microseconds + current;
        node->period_value = microseconds;
        node->timer_id = timer_id_counter++;
        node->callback = cb;
        node->repeated = false;
        list_insert_sorted(node);
        if (linked_list != NULL) {
            timer_hw->alarm[ALARM_NUM] = linked_list->timer_value;
        }
        //  printf("Alarm set to: %lu", timer_hw->alarm[ALARM_NUM]);
        // set alarm[ALARM_NUM] to trigger after count + microseconds
        return node;
        /* TODO */
    }
    node_t* virtual_timer_start_repeated(uint32_t microseconds, virtual_timer_callback_t cb){
        /* TODO */
        uint32_t current = timer_hw->timelr;
        node_t* node = malloc(sizeof(node_t));
        node->timer_value = microseconds + current;
        node->period_value = microseconds;
        node->timer_id = timer_id_counter++;
        node->callback = cb;
        node->repeated = true;
        list_insert_sorted(node);
        if (linked_list != NULL) {
            timer_hw->alarm[ALARM_NUM] = linked_list->timer_value;
        }
        return node;
    }
    uint32_t virtual_timer_cancel(int node1){
        /* TODO */
        node_t* node = (node_t*)node1;
        uint32_t id = node->timer_id;
        if (linked_list == node) {
            if (linked_list->next != NULL) {
                timer_hw->alarm[ALARM_NUM] = linked_list->next->timer_value;
            } else {
                timer_hw->alarm[ALARM_NUM] = 0;
            }
        }
        list_remove(node);
        free(node);
        return id;
    }

  =}
// uint32_t *clear = (uint32_t *) 0xd0000018
  display = new Display()
  timer print_hw_timer(0, 1000ms) 
  timer reset_timer(5000ms) 
  state repeated: int = 0

  reaction(startup) {=
      // initialize the LED and the virtual timer    
      gpio_init(PICO_DEFAULT_LED_PIN);
      gpio_set_dir(PICO_DEFAULT_LED_PIN, GPIO_OUT);
      gpio_put(25, true);
      virtual_timer_init();
    
      virtual_timer_start_repeated(1000000 * 1, virtual_timer_set_callback);
      virtual_timer_start_repeated(1000000 * 2, virtual_timer_set_callback);
  =}
  
  reaction(print_hw_timer) -> display.line0 {=
      /* TODO for 9.2.2 */
      // What is timer_hw->timelr? It is the 0:31 of timer. Lower 32 bits of the timer.
      uint32_t lowerBits = timer_hw->timelr;
      static char buf[17];
      snprintf(buf, 17, "time: %lu", lowerBits/1000000);
      //printf("Time report!");
      lf_set(display.line0, buf);
  =}
  reaction(reset_timer) {=
    //virtual_timer_cancel(self->repeated);
  =}

  /* TODO: add reaction and timer to create the environment to test */
}