target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true,
}

import LED from "LED.lf"

preamble {=
  #include <hardware/gpio.h>
=}

main reactor {

  led = new LED()
  timer t(0, 500 ms)
  timer t1(250 ms, 500 ms)


  reaction(t) -> led.set {=
    printf("LED State: On %b\n");
    lf_set(led.set, true);
  =}

  reaction(t1) -> led.set {=
    printf("LED State: Off %b\n");
    lf_set(led.set, false);
  =}

}