target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true,
  keepalive: true
} 
import Display from "lib/Display.lf"

preamble {=
  #include <stdio.h>
  #include <pico/stdlib.h>
  #include <hardware/gpio.h>
=}
main reactor {
  preamble {=
    static void* action;
    void button_a();
  =}

  d = new Display() 

  physical action a;
  state curr_num: int = 0; 


  reaction(startup) -> a {=
    action = a;
    void button_a() {
        lf_schedule(action, 0);
    }
    gpio_init(PICO_DEFAULT_LED_PIN);
    gpio_set_dir(PICO_DEFAULT_LED_PIN, GPIO_IN);


    gpio_set_irq_enabled_with_callback(PICO_DEFAULT_LED_PIN, GPIO_IRQ_EDGE_FALL,true, &button_a);
    
  =}

  initial mode Increase{
    timer t(0, 1s)
    reaction(t) -> d.line0{=
      static char buf0[17];
      self->curr_num += 1;
      snprintf(buf0, 17, ".: %d", self->curr_num);
      lf_set(d.line0, buf0);
      
      =}

    reaction(a)-> Decrease{= 
      lf_set_mode(Decrease);
    =}  
  
  }
  
  mode Decrease{
    timer t2(0, 500ms)
    reaction(t2) -> d.line0{=
      static char buf0[17];

      self->curr_num -= 1;
      snprintf(buf0, 17, ".:%d", self->curr_num);
      lf_set(d.line0, buf0);
      
      =}


    reaction(a)-> Increase{= 
      lf_set_mode(Increase);
    =} 
  }

}

